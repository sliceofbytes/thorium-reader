{
  "name": "EDRLab.ThoriumReader",
  "version": "3.2.0-alpha.1",
  "description": "Desktop application to read ebooks",
  "keywords": [
    "readium",
    "epub",
    "audiobook"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "clean": "rimraf dist && rimraf release",
    "test": "cross-env JEST_TESTS=1 jest --config=jest.config.js --verbose --runInBand --bail=1 --no-cache \"test\"",

    "build": "cross-env NODE_ENV=production webpack --config webpack.config.js && ncp src/package.json dist/package.json",
    "build:dev": "webpack --config webpack.config.main.js && webpack --config webpack.config.renderer-library.js && webpack --config webpack.config.renderer-reader.js && webpack --config webpack.config.renderer-pdf.js",

    "start": "npm run build && cross-env DEBUG=r2:*,readium-desktop:*,-proxy-agent,-readium-desktop:main#streamerNoHttp,-readium-desktop:main:saga:persist,-r2:navigator#electron/common/readium-css-inject electron .",
    "start:dev": "cross-env DEBUG_COLORS=true npm run start:dev:renderer:pdf && cross-env DEBUG_COLORS=true concurrently --kill-others \"npm run start:dev:renderer:library\" \"npm run start:dev:renderer:reader\" \"npm run start:dev:main\"",

    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint \"src/**/*.{ts,tsx}\" && stylelint \"src/renderer/assets/styles/**/*.scss\"",
    "lint:fix": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint --fix \"src/**/*.{ts,tsx}\" && stylelint --fix \"src/renderer/assets/styles/**/*.scss\"",


    "start:dev:renderer:library": "webpack-dev-server --config webpack.config.renderer-library.js",
    "start:dev:renderer:reader": "webpack-dev-server --config webpack.config.renderer-reader.js",
    "start:dev:renderer:pdf": "webpack --config webpack.config.renderer-pdf.js",
    "start:dev:main": "npm run build:dev && cross-env DEBUG=r2:*,readium-desktop:*,-proxy-agent,-readium-desktop:main#streamerNoHttp,-readium-desktop:main:saga:persist,-r2:navigator#electron/common/readium-css-inject NODE_ENV=development electron --remote-debugging-port=9223 --remote-allow-origins=\"*\" .",


    "pack:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable",
    "pack:mac": "npm run build && cross-env SKIP_NOTARIZE=1 electron-builder --mac",
    "pack:linux": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux dir",


    "i18n-sort": "node ./scripts/locales-sort.js",
    "i18n-scan": "node ./scripts/translate-scan.js \"src/resources/locales/temp.json\" && sync-i18n --files 'src/resources/locales/*.json' --primary temp --languages en ta tr ar cs sl bg ca da de el es eu fi fr gl hr it ja ka ko lt nl pt-br pt-pt ru sv zh-cn zh-tw --space \"    \" --finalnewline --newkeysempty && rimraf \"src/resources/locales/temp.json\"",
    "redux-devtools": "redux-devtools --hostname=localhost --port=7770"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:sliceofbytes/readium-desktop.git"
  },
  "author": {
    "name": "EDRLab",
    "organization": "EDRLab",
    "email": "contact@edrlab.org",
    "url": "http://github.com/edrlab/"
  },
  "license": "BSD-3-Clause",
  "licenses": [
    {
      "type": "BSD-3-Clause",
      "url": "http://opensource.org/licenses/BSD-3-Clause"
    }
  ],
  "bugs": {
    "url": "https://github.com/edrlab/readium-desktop/issues"
  },
  "homepage": "https://github.com/edrlab/readium-desktop",
  "build": {
    "productName": "Thorium",
    "appId": "io.github.edrlab.thorium",
    "protocols": [
      {
        "name": "Thorium Reader - publication link",
        "schemes": [
          "thorium"
        ],
        "role": "Viewer"
      },
      {
        "name": "Thorium Reader - catalog link",
        "schemes": [
          "opds"
        ],
        "role": "Viewer"
      }
    ],
    "afterSign": "scripts/notarize.js",
    "afterPack": "scripts/afterPack.js",
    "dmg": {
      "sign": true,
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "files": [
      "node_modules/",
      "external-assets/",
      "assets/",
      "ReadiumCSS/",
      "MathJax/",
      "index_pdf.js",
      "index_library.html",
      "index_library.js",
      "index_reader.html",
      "index_reader.js",
      "styles_library.css",
      "styles_reader.css",
      "preload.js",
      "main.js",
      "package.json",
      "fonts"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/lcp.node"
    ],
    "directories": {
      "buildResources": "resources",
      "output": "release",
      "app": "dist"
    },
    "fileAssociations": [
      {
        "ext": "epub",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      },
      {
        "ext": "epub3",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      },
      {
        "ext": "pnld",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      },
      {
        "ext": "daisy",
        "role": "Viewer",
        "mimeType": "application/daisy+zip"
      },
      {
        "ext": "lcpl",
        "role": "Viewer",
        "mimeType": "application/vnd.readium.lcp.license.v1.0+json"
      },
      {
        "ext": "audiobook",
        "role": "Viewer",
        "mimeType": "application/audiobook+zip"
      },
      {
        "ext": "webpub",
        "role": "Viewer",
        "mimeType": "application/webpub+zip"
      },
      {
        "ext": "lcpa",
        "role": "Viewer",
        "mimeType": "application/audiobook+lcp"
      },
      {
        "ext": "lcpaudiobook",
        "role": "Viewer",
        "mimeType": "application/audiobook+lcp"
      },
      {
        "ext": "lcpdf",
        "role": "Viewer",
        "mimeType": "application/pdf+lcp"
      }
    ],
    "win": {
      "target": [
        "appx",
        "nsis",
        "portable"
      ],
      "icon": "dist/assets/icons/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}Portable_${version}_${os}_${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "removeDefaultUninstallWelcomePage": false,
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "deb",
        "dir",
        "AppImage"
      ],
      "desktop": {
        "entry": {
          "MimeType": "application/epub+zip"
        }
      },
      "executableName": "thorium",
      "category": "Office",
      "icon": "resources/icons"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg",
      "type": "distribution",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "./scripts/entitlements.mac.plist",
      "entitlementsInherit": "./scripts/entitlements.mac.plist"
    },
    "appx": {
      "displayName": "Thorium Reader",
      "publisher": "CN=C91F86A8-45E6-48E0-8015-8A5BF2B38BD4"
    },
    "publish": null
  },
  "dependencies": {
    "@github/paste-markdown": "^1.5.3",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-popover": "^1.1.14",
