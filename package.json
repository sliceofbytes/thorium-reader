    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "classnames": "^2.5.1",
    "color": "^5.0.0",
    "debounce": "^2.2.0",
    "debug": "^4.4.1",
    "divina-player-js": "git+https://github.com/readium/divina-player-js.git#4e1f859afb14b916923ec136af0284a72e22a990",
    "dompurify": "^3.2.6",
    "fetch-cookie": "^3.1.0",
    "glob": "^11.0.3",
    "history": "^5.3.0",
    "i18next": "^25.3.2",
    "inversify": "^7.6.1",
    "jsdom": "^26.1.0",
    "lunr": "^2.3.9",
    "lunr-languages": "^1.14.0",
    "marked": "^16.1.0",
    "marked-emoji": "^2.0.1",
    "match-sorter": "^8.0.3",
    "mathjax": "^3.2.2",
    "mime-types": "^3.0.1",
    "moment": "^2.30.1",
    "mustache": "^4.2.0",
    "nanoid": "^5.1.5",
    "node-fetch": "^3.3.2",
    "pdf.js": "github:edrlab/pdf.js#build",
    "proxy-agent": "^6.5.0",
    "r2-lcp-js": "^1.0.44",
    "r2-navigator-js": "^1.22.2",
    "r2-opds-js": "^1.0.47",
    "r2-shared-js": "^1.0.84",
    "r2-streamer-js": "^1.0.51",
    "r2-utils-js": "^1.0.43",
    "ramda": "^0.31.3",
    "react": "^18.3.1",
    "react-aria-components": "^1.10.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-focus-lock": "^2.13.6",
    "react-redux": "^9.2.0",
    "react-router": "^6.30.1",
